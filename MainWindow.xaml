<Window x:Class="centre_app.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="应用中心" Icon="Assets/Centre.ico"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="True" Topmost="True"
        Background="#111318" AllowsTransparency="False" AllowDrop="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown"
        PreviewMouseMove="Window_PreviewMouseMove"
        PreviewMouseLeftButtonUp="Window_PreviewMouseLeftButtonUp"
        MouseWheel="Window_MouseWheel"
        DragEnter="Window_DragEnter" DragOver="Window_DragOver" Drop="Window_Drop">
    <Window.Resources>
        <Style x:Key="LauncherButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonRoot" Background="{TemplateBinding Background}" CornerRadius="14" RenderTransformOrigin=".5,.5">
                            <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonRoot" Property="Background" Value="#28FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonRoot" Property="Opacity" Value=".72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CircleActionButton" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#38FFFFFF"/>
            <Setter Property="BorderBrush" Value="#38FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Circle" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="22">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Circle" Property="Background" Value="#58FFFFFF"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Circle" Property="Opacity" Value=".7"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsSlider" TargetType="Slider">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="0,5,0,13"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value}" Orientation="Horizontal" IsDirectionReversed="False">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.DecreaseLarge}" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton"><Grid><Border Height="5" CornerRadius="3" Background="#4F8CFF" VerticalAlignment="Center"/></Grid></ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="18" Height="18">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse x:Name="ThumbCircle" Fill="#F7FAFF" Stroke="#4F8CFF" StrokeThickness="3"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbCircle" Property="Fill" Value="#DCE9FF"/></Trigger>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbCircle" Property="Stroke" Value="#77A7FF"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.IncreaseLarge}" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton"><Grid><Border Height="5" CornerRadius="3" Background="#25FFFFFF" VerticalAlignment="Center"/></Grid></ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="PART_Track" Property="Opacity" Value=".35"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="#12FFFFFF"/>
            <Setter Property="BorderBrush" Value="#20FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="16,14"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Opacity="0" Background="Black" RenderTransformOrigin=".5,.5">
        <Grid.RenderTransform><ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
        <Image x:Name="DesktopBackground" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="Fant"/>
        <Rectangle x:Name="PrimaryDimmer" Fill="#72080B12"/>
        <Rectangle x:Name="EdgeDimmer">
            <Rectangle.Fill>
                <RadialGradientBrush Center=".5,.42" GradientOrigin=".5,.42" RadiusX=".8" RadiusY=".9">
                    <GradientStop Color="#15000000" Offset="0"/><GradientStop Color="#8B000000" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid x:Name="NormalLauncherShell" Margin="46,32,46,26">
            <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Border x:Name="NormalSearchSurface" Width="300" Height="40" CornerRadius="20" HorizontalAlignment="Center" Background="#42FFFFFF" BorderBrush="#42FFFFFF" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Width="15" Height="15" Stroke="#E8FFFFFF" StrokeThickness="2" Data="M 13,13 L 18,18 M 15,9 A 6,6 0 1 1 3,9 A 6,6 0 1 1 15,9" Stretch="Uniform"/>
                        <TextBox x:Name="SearchBox" Grid.Column="1" FontFamily="Segoe UI Variable Text,Segoe UI" FontSize="15" Foreground="White" CaretBrush="White" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged"/>
                        <TextBlock x:Name="SearchHint" Grid.Column="1" Text="搜索" FontSize="15" Foreground="#D8FFFFFF" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <Button x:Name="ClearSearchButton" Grid.Column="2" Content="×" Foreground="White" FontSize="20" Background="Transparent" BorderThickness="0" Cursor="Hand" Visibility="Collapsed" Click="ClearSearchButton_Click"/>
                    </Grid>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="AddButton" Style="{StaticResource CircleActionButton}" Content="＋" FontSize="25" ToolTip="添加应用" Click="AddButton_Click"/>
                    <Button x:Name="SettingsButton" Style="{StaticResource CircleActionButton}" Content="⚙" FontSize="20" ToolTip="设置" Click="SettingsButton_Click"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" x:Name="PageHost" ClipToBounds="True">
                <UniformGrid x:Name="AppGrid" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" AllowDrop="True" Drop="AppGrid_Drop" DragOver="AppGrid_DragOver"/>
                <Canvas x:Name="DragOverlay" IsHitTestVisible="False">
                    <Border x:Name="DropIndicator" Width="4" Height="104" CornerRadius="2" Background="#FF6EA8" Visibility="Collapsed"/>
                </Canvas>
                <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <Image Source="Assets/startIcon.png" Width="96" Height="96" Margin="0,0,0,22"/>
                    <TextBlock Text="还没有添加应用" Foreground="White" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="点击右上角 ＋，或将应用拖放到这里" Foreground="#B8FFFFFF" FontSize="14" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="SearchEmptyText" Text="没有找到应用" Foreground="#D8FFFFFF" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
            <StackPanel Grid.Row="2" x:Name="PageIndicators" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <Button x:Name="PreviousPageButton" Style="{StaticResource CircleActionButton}" Width="42" Height="42" Margin="14,0,0,0"
                HorizontalAlignment="Left" VerticalAlignment="Center" Padding="0"
                ToolTip="上一页" AutomationProperties.Name="上一页" Visibility="Collapsed" AllowDrop="True"
                Click="PreviousPageButton_Click" DragOver="AppGrid_DragOver" Drop="AppGrid_Drop">
            <Path Width="9" Height="16" Data="M 8,1 L 1,8 L 8,15" Stretch="Fill" Stroke="White" StrokeThickness="2.4"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" IsHitTestVisible="False"/>
        </Button>
        <Button x:Name="NextPageButton" Style="{StaticResource CircleActionButton}" Width="42" Height="42" Margin="0,0,14,0"
                HorizontalAlignment="Right" VerticalAlignment="Center" Padding="0"
                ToolTip="下一页" AutomationProperties.Name="下一页" Visibility="Collapsed" AllowDrop="True"
                Click="NextPageButton_Click" DragOver="AppGrid_DragOver" Drop="AppGrid_Drop">
            <Path Width="9" Height="16" Data="M 1,1 L 8,8 L 1,15" Stretch="Fill" Stroke="White" StrokeThickness="2.4"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" IsHitTestVisible="False"/>
        </Button>

        <Grid x:Name="SpotlightShell" Visibility="Collapsed">
            <Border x:Name="SpotlightCard" Width="860" Height="190" HorizontalAlignment="Center" VerticalAlignment="Center"
                    CornerRadius="40" BorderThickness="1" ClipToBounds="True"
                    RenderTransformOrigin=".5,.5">
                <Border.Effect><DropShadowEffect x:Name="SpotlightShadow" BlurRadius="52" ShadowDepth="16" Opacity=".52"/></Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="86"/>
                        <RowDefinition Height="1"/>
                        <RowDefinition Height="102"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="28,18,24,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Width="52" Height="52" CornerRadius="16" VerticalAlignment="Center">
                            <Image Source="Assets/startIcon.png" Width="52" Height="52"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="SpotlightTitle" Text="应用中心" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock x:Name="SpotlightSubtitle" Text="快速查找并启动应用" FontSize="12.5" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="SpotlightKeyboardHints" Text="↑↓ 选择   ↵ 打开   esc 关闭" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Button x:Name="SpotlightAddButton" Style="{StaticResource CircleActionButton}" Content="＋" FontSize="22" ToolTip="添加应用" Click="AddButton_Click"/>
                            <Button x:Name="SpotlightSettingsButton" Style="{StaticResource CircleActionButton}" Content="⚙" FontSize="18" ToolTip="设置" Click="SettingsButton_Click"/>
                        </StackPanel>
                    </Grid>

                    <Border x:Name="SpotlightDivider" Grid.Row="1"/>

                    <Grid Grid.Row="2" Margin="28,17,28,15">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Path x:Name="SpotlightSearchIcon" Grid.Column="0" Width="21" Height="21" StrokeThickness="2.2" Data="M 13,13 L 18,18 M 15,9 A 6,6 0 1 1 3,9 A 6,6 0 1 1 15,9" Stretch="Uniform"/>
                        <TextBox x:Name="SpotlightSearchBox" Grid.Column="1" FontFamily="Segoe UI Variable Display,Segoe UI" FontSize="25"
                                 FontWeight="Light" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"
                                 TextChanged="SpotlightSearchBox_TextChanged" PreviewKeyDown="SpotlightSearchBox_PreviewKeyDown"/>
                        <TextBlock x:Name="SpotlightSearchHint" Grid.Column="1" Text="搜索应用…" FontFamily="Segoe UI Variable Display,Segoe UI"
                                   FontSize="25" FontWeight="Light" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>

                    <Border x:Name="SpotlightResultsBorder" Grid.Row="3" BorderThickness="0,1,0,0" Visibility="Collapsed" Padding="14,10,14,14">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="SpotlightResults"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <TextBlock x:Name="LauncherFooterHint" Text="Esc 返回桌面  ·  Shift + Tab 随时呼出" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="22,0,0,14" Foreground="#72FFFFFF" FontSize="12"/>
        <TextBlock x:Name="BrandFooter" Text="应用中心" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,22,14" Foreground="#68FFFFFF" FontWeight="SemiBold" FontSize="12"/>

        <Border x:Name="ToastBorder" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,72"
                Background="#E52A2F3A" BorderBrush="#45FFFFFF" BorderThickness="1" CornerRadius="18"
                Padding="18,9" Visibility="Collapsed">
            <TextBlock x:Name="ToastText" Foreground="White" FontSize="13"/>
        </Border>

        <Border x:Name="UpdateBanner" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0"
                Background="#F02A2F3A" BorderBrush="#45FFFFFF" BorderThickness="1" CornerRadius="18"
                Padding="16,10" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="UpdateBannerText" Foreground="White" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Button Content="查看更新" Padding="12,5" Margin="0,0,8,0" Click="ViewUpdate_Click"/>
                <Button Content="忽略" Padding="12,5" Click="DismissUpdate_Click"/>
            </StackPanel>
        </Border>

        <Grid x:Name="SettingsLayer" Visibility="Collapsed">
            <Grid.Resources>
                <Style TargetType="Button">
                    <Setter Property="Foreground" Value="#F4FFFFFF"/>
                    <Setter Property="Background" Value="#16FFFFFF"/>
                    <Setter Property="BorderBrush" Value="#28FFFFFF"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="Padding" Value="14,7"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="#26FFFFFF"/><Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#40FFFFFF"/></Trigger>
                                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value=".72"/></Trigger>
                                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonSurface" Property="Opacity" Value=".4"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style x:Key="PrimarySettingsButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="Background" Value="#4F8CFF"/>
                    <Setter Property="BorderBrush" Value="#6DA0FF"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Style>
                <Style TargetType="TextBox">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="CaretBrush" Value="White"/>
                    <Setter Property="Background" Value="#12FFFFFF"/>
                    <Setter Property="BorderBrush" Value="#2CFFFFFF"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="Padding" Value="12,7"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TextBox">
                                <Border x:Name="TextSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                                    <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TextSurface" Property="BorderBrush" Value="#698FFF"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style TargetType="CheckBox">
                    <Setter Property="Width" Value="44"/>
                    <Setter Property="Height" Value="24"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="CheckBox">
                                <Grid>
                                    <Border x:Name="ToggleTrack" CornerRadius="12" Background="#2AFFFFFF" BorderBrush="#34FFFFFF" BorderThickness="1"/>
                                    <Ellipse x:Name="ToggleThumb" Width="18" Height="18" Margin="3" HorizontalAlignment="Left" Fill="#DCE2EC"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="ToggleTrack" Property="Background" Value="#4F8CFF"/><Setter TargetName="ToggleTrack" Property="BorderBrush" Value="#6DA0FF"/><Setter TargetName="ToggleThumb" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="ToggleThumb" Property="Fill" Value="White"/></Trigger>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ToggleTrack" Property="Opacity" Value=".86"/></Trigger>
                                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style x:Key="SettingsScrollThumb" TargetType="Thumb">
                    <Setter Property="Width" Value="6"/>
                    <Setter Property="Margin" Value="1"/>
                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border Background="#48FFFFFF" CornerRadius="3"/></ControlTemplate></Setter.Value></Setter>
                </Style>
                <Style TargetType="ScrollBar">
                    <Setter Property="Width" Value="8"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
                                    <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" IsTabStop="False"/></Track.DecreaseRepeatButton>
                                    <Track.Thumb><Thumb Style="{StaticResource SettingsScrollThumb}"/></Track.Thumb>
                                    <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" IsTabStop="False"/></Track.IncreaseRepeatButton>
                                </Track>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Grid.Resources>
            <Button Background="#52000000" BorderThickness="0" Click="SettingsScrim_Click" Cursor="Arrow"/>
            <Border x:Name="SettingsDrawer" Width="410" HorizontalAlignment="Right" Margin="0,14,14,14"
                    Background="#FA181C25" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="24"
                    RenderTransformOrigin="1,.5">
                <Border.RenderTransform><TranslateTransform x:Name="SettingsTranslate" X="430"/></Border.RenderTransform>
                <Grid Margin="27,24">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="Assets/startIcon.png" Width="34" Height="34" Margin="0,0,12,0"/>
                            <StackPanel><TextBlock Text="应用中心设置" Foreground="White" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="外观与窗口" Foreground="#98FFFFFF" FontSize="12"/></StackPanel>
                        </StackPanel>
                        <Button Content="×" HorizontalAlignment="Right" VerticalAlignment="Top" Width="32" Height="32" Padding="0" FontSize="20" Foreground="White" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="CancelSettings_Click"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,28,0,20">
                        <StackPanel>
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="中央悬浮搜索" Foreground="White" FontSize="15"/><TextBlock Text="超大圆角、一体化搜索与键盘导航" Foreground="#92FFFFFF" FontSize="12" Margin="0,3,0,0"/></StackPanel>
                                    <CheckBox x:Name="FloatingSearchModeCheck" Grid.Column="1" VerticalAlignment="Center" Checked="SettingsControl_Changed" Unchecked="SettingsControl_Changed"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,22">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="铺满桌面" Foreground="White" FontSize="15"/><TextBlock Text="铺满桌面工作区，同时保留 Windows 任务栏" Foreground="#92FFFFFF" FontSize="12" Margin="0,3,0,0"/></StackPanel>
                                    <CheckBox x:Name="FullScreenCheck" Grid.Column="1" VerticalAlignment="Center" Checked="SettingsControl_Changed" Unchecked="SettingsControl_Changed"/>
                                </Grid>
                            </Border>

                            <StackPanel x:Name="WindowSizePanel">
                                <Grid><TextBlock Text="窗口宽度" Foreground="White"/><TextBlock x:Name="WidthValueText" HorizontalAlignment="Right" Foreground="#B8FFFFFF"/></Grid>
                                <Slider x:Name="WidthSlider" Minimum="800" TickFrequency="20" Style="{StaticResource SettingsSlider}" ValueChanged="SettingsControl_Changed"/>
                                <Grid><TextBlock Text="窗口高度" Foreground="White"/><TextBlock x:Name="HeightValueText" HorizontalAlignment="Right" Foreground="#B8FFFFFF"/></Grid>
                                <Slider x:Name="HeightSlider" Minimum="600" TickFrequency="20" Style="{StaticResource SettingsSlider}" ValueChanged="SettingsControl_Changed"/>
                            </StackPanel>

                            <StackPanel x:Name="AppAreaSizePanel" Margin="0,4,0,0">
                                <TextBlock Text="应用显示区域（全屏模式）" Foreground="#D8FFFFFF" FontSize="13" Margin="0,0,0,10"/>
                                <Grid><TextBlock Text="区域宽度" Foreground="White"/><TextBlock x:Name="AppAreaWidthValueText" HorizontalAlignment="Right" Foreground="#B8FFFFFF"/></Grid>
                                <Slider x:Name="AppAreaWidthSlider" Minimum="600" TickFrequency="20" Style="{StaticResource SettingsSlider}" ValueChanged="SettingsControl_Changed"/>
                                <Grid><TextBlock Text="区域高度" Foreground="White"/><TextBlock x:Name="AppAreaHeightValueText" HorizontalAlignment="Right" Foreground="#B8FFFFFF"/></Grid>
                                <Slider x:Name="AppAreaHeightSlider" Minimum="420" TickFrequency="20" Style="{StaticResource SettingsSlider}" ValueChanged="SettingsControl_Changed"/>
                            </StackPanel>

                            <Separator Background="#35FFFFFF" Margin="0,8,0,20"/>
                            <Grid><TextBlock Text="每页列数" Foreground="White"/><TextBlock x:Name="ColumnsValueText" HorizontalAlignment="Right" Foreground="#B8FFFFFF"/></Grid>
                            <Slider x:Name="ColumnsSlider" Minimum="4" Maximum="12" TickFrequency="1" Style="{StaticResource SettingsSlider}" ValueChanged="SettingsControl_Changed"/>
                            <Grid><TextBlock Text="每页行数" Foreground="White"/><TextBlock x:Name="RowsValueText" HorizontalAlignment="Right" Foreground="#B8FFFFFF"/></Grid>
                            <Slider x:Name="RowsSlider" Minimum="3" Maximum="8" TickFrequency="1" Style="{StaticResource SettingsSlider}" ValueChanged="SettingsControl_Changed"/>
                            <Grid><TextBlock Text="图标大小" Foreground="White"/><TextBlock x:Name="IconSizeValueText" HorizontalAlignment="Right" Foreground="#B8FFFFFF"/></Grid>
                            <Slider x:Name="IconSizeSlider" Minimum="48" Maximum="128" TickFrequency="4" Style="{StaticResource SettingsSlider}" ValueChanged="SettingsControl_Changed"/>

                            <Border Style="{StaticResource SettingsCard}" Margin="0,8,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="图标圆角遮罩" Foreground="White" FontSize="15"/><TextBlock Text="将应用图标裁剪为统一的圆角方形，默认关闭" Foreground="#92FFFFFF" FontSize="12" Margin="0,3,0,0"/></StackPanel>
                                    <CheckBox x:Name="IconMaskCheck" Grid.Column="1" VerticalAlignment="Center" Checked="SettingsControl_Changed" Unchecked="SettingsControl_Changed"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="拼音检索" Foreground="White" FontSize="15"/><TextBlock Text="支持用 weixin、wx 搜索“微信”；关闭后卸载拼音词库" Foreground="#92FFFFFF" FontSize="12" Margin="0,3,0,0"/></StackPanel>
                                    <CheckBox x:Name="PinyinSearchCheck" Grid.Column="1" VerticalAlignment="Center" Checked="SettingsControl_Changed" Unchecked="SettingsControl_Changed"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="纯黑静态背景" Foreground="White" FontSize="15"/><TextBlock Text="不截取桌面，进一步降低内存和唤出开销" Foreground="#92FFFFFF" FontSize="12" Margin="0,3,0,0"/></StackPanel>
                                    <CheckBox x:Name="StaticBlackBackgroundCheck" Grid.Column="1" VerticalAlignment="Center" Checked="SettingsControl_Changed" Unchecked="SettingsControl_Changed"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="软件渲染兼容模式" Foreground="White" FontSize="15"/><TextBlock Text="仅在显卡兼容异常时启用，保存后重启生效" Foreground="#92FFFFFF" FontSize="12" Margin="0,3,0,0"/></StackPanel>
                                    <CheckBox x:Name="SoftwareRenderingCheck" Grid.Column="1" VerticalAlignment="Center" Checked="SettingsControl_Changed" Unchecked="SettingsControl_Changed"/>
                                </Grid>
                            </Border>
                            <StackPanel x:Name="BackgroundBlurPanel">
                                <Grid><TextBlock Text="背景模糊强度" Foreground="White"/><TextBlock x:Name="BackgroundBlurValueText" HorizontalAlignment="Right" Foreground="#B8FFFFFF"/></Grid>
                                <Slider x:Name="BackgroundBlurSlider" Minimum="0" Maximum="40" TickFrequency="2" Style="{StaticResource SettingsSlider}" ValueChanged="SettingsControl_Changed"/>
                            </StackPanel>

                            <Separator Background="#35FFFFFF" Margin="0,8,0,20"/>
                            <TextBlock Text="唤出快捷键" Foreground="White" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="HotkeyTextBox" Height="36" IsReadOnly="True" TextAlignment="Center" VerticalContentAlignment="Center"
                                         PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"/>
                                <Button Grid.Column="1" Content="恢复默认" Margin="8,0,0,0" Padding="12,0" Click="ResetHotkey_Click"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                <Button Content="Alt" Padding="12,6" Margin="0,0,8,0" Click="AltPreset_Click"/>
                                <Button Content="Shift + Tab" Padding="12,6" Margin="0,0,8,0" Click="ShiftTabPreset_Click"/>
                                <Button Content="Alt + Space" Padding="12,6" Click="AltSpacePreset_Click"/>
                            </StackPanel>

                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="自动检查更新" Foreground="White" FontSize="15"/><TextBlock Text="每天最多检查一次 GitHub Releases" Foreground="#92FFFFFF" FontSize="12" Margin="0,3,0,0"/></StackPanel>
                                    <CheckBox x:Name="AutoUpdateCheck" Grid.Column="1" VerticalAlignment="Center" Checked="SettingsControl_Changed" Unchecked="SettingsControl_Changed"/>
                                </Grid>
                            </Border>
                            <Button Content="立即检查更新" Height="42" Style="{StaticResource PrimarySettingsButton}" Click="CheckUpdates_Click"/>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="取消" Width="92" Height="40" Margin="0,0,10,0" Click="CancelSettings_Click"/>
                        <Button Content="保存" Width="104" Height="40" Style="{StaticResource PrimarySettingsButton}" Click="SaveSettings_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
