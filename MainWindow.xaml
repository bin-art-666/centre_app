<Window x:Class="centre_app.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Centre" Icon="Assets/Centre.ico"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="#111318" AllowsTransparency="False" AllowDrop="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown"
        PreviewMouseMove="Window_PreviewMouseMove"
        PreviewMouseLeftButtonUp="Window_PreviewMouseLeftButtonUp"
        MouseWheel="Window_MouseWheel"
        DragEnter="Window_DragEnter" DragOver="Window_DragOver" Drop="Window_Drop">
    <Window.Resources>
        <Style x:Key="LauncherButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonRoot" Background="{TemplateBinding Background}" CornerRadius="14" RenderTransformOrigin=".5,.5">
                            <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonRoot" Property="Background" Value="#28FFFFFF"/>
                                <Setter TargetName="ButtonRoot" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1.055" ScaleY="1.055"/></Setter.Value></Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonRoot" Property="Opacity" Value=".72"/>
                                <Setter TargetName="ButtonRoot" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX=".95" ScaleY=".95"/></Setter.Value></Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CircleActionButton" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#38FFFFFF"/>
            <Setter Property="BorderBrush" Value="#38FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Circle" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="22">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Circle" Property="Background" Value="#58FFFFFF"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Circle" Property="Opacity" Value=".7"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsSlider" TargetType="Slider">
            <Setter Property="Margin" Value="0,7,0,13"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Opacity="0" RenderTransformOrigin=".5,.5">
        <Grid.RenderTransform><ScaleTransform x:Name="RootScale" ScaleX="1.08" ScaleY="1.08"/></Grid.RenderTransform>
        <Image x:Name="DesktopBackground" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="Fant"/>
        <Rectangle x:Name="PrimaryDimmer" Fill="#72080B12"/>
        <Rectangle x:Name="EdgeDimmer">
            <Rectangle.Fill>
                <RadialGradientBrush Center=".5,.42" GradientOrigin=".5,.42" RadiusX=".8" RadiusY=".9">
                    <GradientStop Color="#15000000" Offset="0"/><GradientStop Color="#8B000000" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid x:Name="NormalLauncherShell" Margin="46,32,46,26">
            <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Border x:Name="NormalSearchSurface" Width="300" Height="40" CornerRadius="20" HorizontalAlignment="Center" Background="#42FFFFFF" BorderBrush="#42FFFFFF" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Width="15" Height="15" Stroke="#E8FFFFFF" StrokeThickness="2" Data="M 13,13 L 18,18 M 15,9 A 6,6 0 1 1 3,9 A 6,6 0 1 1 15,9" Stretch="Uniform"/>
                        <TextBox x:Name="SearchBox" Grid.Column="1" FontFamily="Segoe UI Variable Text,Segoe UI" FontSize="15" Foreground="White" CaretBrush="White" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged"/>
                        <TextBlock x:Name="SearchHint" Grid.Column="1" Text="搜索" FontSize="15" Foreground="#D8FFFFFF" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <Button x:Name="ClearSearchButton" Grid.Column="2" Content="×" Foreground="White" FontSize="20" Background="Transparent" BorderThickness="0" Cursor="Hand" Visibility="Collapsed" Click="ClearSearchButton_Click"/>
                    </Grid>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="AddButton" Style="{StaticResource CircleActionButton}" Content="＋" FontSize="25" ToolTip="添加应用" Click="AddButton_Click"/>
                    <Button x:Name="SettingsButton" Style="{StaticResource CircleActionButton}" Content="⚙" FontSize="20" ToolTip="设置" Click="SettingsButton_Click"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" x:Name="PageHost" ClipToBounds="True">
                <UniformGrid x:Name="AppGrid" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" AllowDrop="True" Drop="AppGrid_Drop" DragOver="AppGrid_DragOver"/>
                <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <Image Source="Assets/startIcon.png" Width="96" Height="96" Margin="0,0,0,22"/>
                    <TextBlock Text="还没有添加应用" Foreground="White" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="点击右上角 ＋，或将应用拖放到这里" Foreground="#B8FFFFFF" FontSize="14" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="SearchEmptyText" Text="没有找到应用" Foreground="#D8FFFFFF" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
            <StackPanel Grid.Row="2" x:Name="PageIndicators" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <Grid x:Name="SpotlightShell" Visibility="Collapsed">
            <Border x:Name="SpotlightCard" Width="860" Height="190" HorizontalAlignment="Center" VerticalAlignment="Center"
                    CornerRadius="40" BorderThickness="1" ClipToBounds="True"
                    RenderTransformOrigin=".5,.5">
                <Border.Effect><DropShadowEffect x:Name="SpotlightShadow" BlurRadius="52" ShadowDepth="16" Opacity=".52"/></Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="86"/>
                        <RowDefinition Height="1"/>
                        <RowDefinition Height="102"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="28,18,24,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Width="52" Height="52" CornerRadius="16" VerticalAlignment="Center">
                            <Image Source="Assets/startIcon.png" Width="52" Height="52"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="SpotlightTitle" Text="Centre" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock x:Name="SpotlightSubtitle" Text="快速查找并启动应用" FontSize="12.5" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="SpotlightKeyboardHints" Text="↑↓ 选择   ↵ 打开   esc 关闭" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Button x:Name="SpotlightAddButton" Style="{StaticResource CircleActionButton}" Content="＋" FontSize="22" ToolTip="添加应用" Click="AddButton_Click"/>
                            <Button x:Name="SpotlightSettingsButton" Style="{StaticResource CircleActionButton}" Content="⚙" FontSize="18" ToolTip="设置" Click="SettingsButton_Click"/>
                        </StackPanel>
                    </Grid>

                    <Border x:Name="SpotlightDivider" Grid.Row="1"/>

                    <Grid Grid.Row="2" Margin="28,17,28,15">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Path x:Name="SpotlightSearchIcon" Grid.Column="0" Width="21" Height="21" StrokeThickness="2.2" Data="M 13,13 L 18,18 M 15,9 A 6,6 0 1 1 3,9 A 6,6 0 1 1 15,9" Stretch="Uniform"/>
                        <TextBox x:Name="SpotlightSearchBox" Grid.Column="1" FontFamily="Segoe UI Variable Display,Segoe UI" FontSize="25"
                                 FontWeight="Light" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"
                                 TextChanged="SpotlightSearchBox_TextChanged" PreviewKeyDown="SpotlightSearchBox_PreviewKeyDown"/>
                        <TextBlock x:Name="SpotlightSearchHint" Grid.Column="1" Text="搜索应用…" FontFamily="Segoe UI Variable Display,Segoe UI"
                                   FontSize="25" FontWeight="Light" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>

                    <Border x:Name="SpotlightResultsBorder" Grid.Row="3" BorderThickness="0,1,0,0" Visibility="Collapsed" Padding="14,10,14,14">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="SpotlightResults"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <TextBlock x:Name="LauncherFooterHint" Text="Esc 返回桌面  ·  Shift + Tab 随时呼出" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="22,0,0,14" Foreground="#72FFFFFF" FontSize="12"/>
        <TextBlock x:Name="BrandFooter" Text="CENTRE" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,22,14" Foreground="#68FFFFFF" FontWeight="SemiBold" FontSize="12"/>

        <Border x:Name="ToastBorder" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,72"
                Background="#E52A2F3A" BorderBrush="#45FFFFFF" BorderThickness="1" CornerRadius="18"
                Padding="18,9" Visibility="Collapsed">
            <TextBlock x:Name="ToastText" Foreground="White" FontSize="13"/>
        </Border>

        <Grid x:Name="SettingsLayer" Visibility="Collapsed">
            <Button Background="#52000000" BorderThickness="0" Click="SettingsScrim_Click" Cursor="Arrow"/>
            <Border x:Name="SettingsDrawer" Width="410" HorizontalAlignment="Right" Margin="0,14,14,14"
                    Background="#F2252933" BorderBrush="#42FFFFFF" BorderThickness="1" CornerRadius="24"
                    RenderTransformOrigin="1,.5">
                <Border.RenderTransform><TranslateTransform x:Name="SettingsTranslate" X="430"/></Border.RenderTransform>
                <Grid Margin="27,24">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="Assets/startIcon.png" Width="34" Height="34" Margin="0,0,12,0"/>
                            <StackPanel><TextBlock Text="Centre 设置" Foreground="White" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="外观与窗口" Foreground="#98FFFFFF" FontSize="12"/></StackPanel>
                        </StackPanel>
                        <Button Content="×" HorizontalAlignment="Right" VerticalAlignment="Top" Width="32" Height="32" FontSize="20" Foreground="White" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="CancelSettings_Click"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,28,0,20">
                        <StackPanel>
                            <Border Background="#20FFFFFF" CornerRadius="14" Padding="16,13" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="中央悬浮搜索" Foreground="White" FontSize="15"/><TextBlock Text="超大圆角、一体化搜索与键盘导航" Foreground="#92FFFFFF" FontSize="12" Margin="0,3,0,0"/></StackPanel>
                                    <CheckBox x:Name="FloatingSearchModeCheck" Grid.Column="1" VerticalAlignment="Center" Checked="SettingsControl_Changed" Unchecked="SettingsControl_Changed"/>
                                </Grid>
                            </Border>
                            <Border Background="#20FFFFFF" CornerRadius="14" Padding="16,13" Margin="0,0,0,22">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="全屏显示" Foreground="White" FontSize="15"/><TextBlock Text="覆盖当前屏幕并隐藏窗口边缘" Foreground="#92FFFFFF" FontSize="12" Margin="0,3,0,0"/></StackPanel>
                                    <CheckBox x:Name="FullScreenCheck" Grid.Column="1" VerticalAlignment="Center" Checked="SettingsControl_Changed" Unchecked="SettingsControl_Changed"/>
                                </Grid>
                            </Border>

                            <StackPanel x:Name="WindowSizePanel">
                                <Grid><TextBlock Text="窗口宽度" Foreground="White"/><TextBlock x:Name="WidthValueText" HorizontalAlignment="Right" Foreground="#B8FFFFFF"/></Grid>
                                <Slider x:Name="WidthSlider" Minimum="800" TickFrequency="20" Style="{StaticResource SettingsSlider}" ValueChanged="SettingsControl_Changed"/>
                                <Grid><TextBlock Text="窗口高度" Foreground="White"/><TextBlock x:Name="HeightValueText" HorizontalAlignment="Right" Foreground="#B8FFFFFF"/></Grid>
                                <Slider x:Name="HeightSlider" Minimum="600" TickFrequency="20" Style="{StaticResource SettingsSlider}" ValueChanged="SettingsControl_Changed"/>
                            </StackPanel>

                            <Separator Background="#35FFFFFF" Margin="0,8,0,20"/>
                            <Grid><TextBlock Text="每页列数" Foreground="White"/><TextBlock x:Name="ColumnsValueText" HorizontalAlignment="Right" Foreground="#B8FFFFFF"/></Grid>
                            <Slider x:Name="ColumnsSlider" Minimum="4" Maximum="12" TickFrequency="1" Style="{StaticResource SettingsSlider}" ValueChanged="SettingsControl_Changed"/>
                            <Grid><TextBlock Text="每页行数" Foreground="White"/><TextBlock x:Name="RowsValueText" HorizontalAlignment="Right" Foreground="#B8FFFFFF"/></Grid>
                            <Slider x:Name="RowsSlider" Minimum="3" Maximum="8" TickFrequency="1" Style="{StaticResource SettingsSlider}" ValueChanged="SettingsControl_Changed"/>
                            <Grid><TextBlock Text="图标大小" Foreground="White"/><TextBlock x:Name="IconSizeValueText" HorizontalAlignment="Right" Foreground="#B8FFFFFF"/></Grid>
                            <Slider x:Name="IconSizeSlider" Minimum="48" Maximum="128" TickFrequency="4" Style="{StaticResource SettingsSlider}" ValueChanged="SettingsControl_Changed"/>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="取消" Width="92" Height="38" Margin="0,0,10,0" Click="CancelSettings_Click"/>
                        <Button Content="保存" Width="104" Height="38" Click="SaveSettings_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
